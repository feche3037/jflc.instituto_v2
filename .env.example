# ============================================================
# .env.example — Plantilla de variables de entorno
# Taller de Programación · Clase 4 · ISDEM 2026
#
# INSTRUCCIONES:
# 1) Copiá este archivo y renombralo a ".env" (sin .example)
# 2) Generá tu propio SECRET_KEY (ver instructivo)
# 3) El archivo ".env" real NUNCA se sube a git (ya está en .gitignore)
# ============================================================

# Clave secreta de Django. Generar una propia, no usar la de ejemplo.
SECRET_KEY=django-insecure-CAMBIAR-ESTA-CLAVE-POR-UNA-PROPIA-Y-UNICA

# True en desarrollo, False en producción
DEBUG=True

# Hosts permitidos, separados por coma (sin espacios)
ALLOWED_HOSTS=127.0.0.1,localhost
